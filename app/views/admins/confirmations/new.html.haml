.w-full.flex.justify-center
  .card.w-full.max-w-md.bg-base-100.shadow-xl.border.border-base-300
    .card-body
      %h1.text-2xl.font-bold.text-center.mb-1 Resend confirmation
      %p.text-center.text-sm.opacity-70.mb-4 We'll email you fresh confirmation instructions.
      = simple_form_for(resource, as: resource_name, url: confirmation_path(resource_name), html: { method: :post }) do |f|
        = f.error_notification
        = f.input :email, required: true, autofocus: true, placeholder: "you@example.com", input_html: { autocomplete: "email", value: (resource.pending_reconfirmation? ? resource.unconfirmed_email : resource.email) }
        .mt-6
          = f.button :submit, "Resend confirmation instructions", class: "btn btn-primary w-full"
      = render "admins/shared/links"
