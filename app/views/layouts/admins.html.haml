!!!
%html
  %head
    %meta{:content => "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
    %title Admin · SessionHero
    %meta{name: "viewport", content: "width=device-width,initial-scale=1"}
    = csrf_meta_tags
    = csp_meta_tag
    = yield :head
    = render "shared/favicons"
    = render "shared/analytics"
    %link{:href => "https://fonts.googleapis.com", :rel => "preconnect"}/
    %link{:crossorigin => "", :href => "https://fonts.gstatic.com", :rel => "preconnect"}/
    %link{:href => "https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap", :rel => "stylesheet", "data-clarity-unmask" => "true"}/
    = stylesheet_link_tag :app, "data-turbo-track": "reload", "data-clarity-unmask": "true"
    = javascript_importmap_tags
  %body.min-h-screen.bg-base-200
    %header.navbar.bg-base-100.shadow-sm.border-b.border-base-300
      .container.mx-auto.px-5.flex.items-center
        .flex-1
          = link_to "SessionHero", admins_dashboard_path, class: "text-xl font-bold text-primary"
          %span.badge.badge-primary.badge-sm.ml-2.align-middle Admin
        %nav.flex.items-center.gap-1
          = link_to "Dashboard", admins_dashboard_path, class: "btn btn-ghost btn-sm"
          = button_to "Sign out", destroy_admin_session_path, method: :delete, class: "btn btn-outline btn-sm"
    = render 'shared/flash'
    %main.container.mx-auto.px-5.py-8= yield
