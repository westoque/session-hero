!!!
%html{ "data-theme": "facebook" }
  %head
    %meta{ "http-equiv": "Content-Type", content: "text/html; charset=UTF-8" }/
    %title= title_tag
    %meta{ name: "viewport", content: "width=device-width,initial-scale=1" }/
    = csrf_meta_tags
    = csp_meta_tag
    = yield :head
    %link{ href: "https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap", rel: "stylesheet" }/
    = stylesheet_link_tag :app, "data-turbo-track": "reload"
    = javascript_importmap_tags
  %body.bg-base-200.min-h-screen
    - speaker = current_speakers.first
    - nav_link = ->(path, label){ link_to label, path, class: "btn btn-ghost btn-sm #{'btn-active' if current_page?(path)}" }
    %header.navbar.bg-primary.text-primary-content.sticky.top-0.z-30.shadow
      .flex-1.flex.items-center.gap-3.px-2
        = link_to portal_root_path, class: "flex items-center gap-2" do
          %span.text-lg.font-bold Speaker Portal
        - if portal_events.size == 1
          %span.badge.badge-sm.bg-primary-content.text-primary.border-0= portal_events.first.name
        - elsif portal_events.size > 1
          .dropdown
            %label.btn.btn-ghost.btn-sm.gap-1{ tabindex: 0 }
              = "#{portal_events.size} events"
              %span ▾
            %ul.menu.dropdown-content.bg-base-100.text-base-content.rounded-box.shadow.z-40.w-56.p-2{ tabindex: 0 }
              - portal_events.each do |ev|
                %li= link_to ev.name, portal_sessions_path
      .flex-none.hidden.md:flex.gap-1
        = nav_link.(portal_root_path, "Dashboard")
        = nav_link.(portal_sessions_path, "My Sessions")
        = nav_link.(portal_tasks_path, "Tasks")
        = nav_link.(edit_portal_profile_path, "Profile")
      .flex-none.flex.items-center.gap-2.px-2
        - if speaker
          .flex.items-center.gap-2
            = speaker_avatar(speaker, size: 8)
            %span.hidden.sm:inline.text-sm.font-medium= speaker.name
        = button_to "Sign out", destroy_user_session_path, method: :delete, class: "btn btn-ghost btn-sm"
    / Mobile nav
    .navbar.bg-base-100.border-b.border-base-300.md:hidden.flex.gap-1.overflow-x-auto.px-2
      = nav_link.(portal_root_path, "Dashboard")
      = nav_link.(portal_sessions_path, "Sessions")
      = nav_link.(portal_tasks_path, "Tasks")
      = nav_link.(edit_portal_profile_path, "Profile")
    %main.p-5.lg:p-8
      = render "shared/flash"
      = yield
