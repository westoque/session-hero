!!!
%html{ "data-theme": "facebook" }
  %head
    %meta{ "http-equiv": "Content-Type", content: "text/html; charset=UTF-8" }/
    %title= content_for(:title).presence || "#{@event&.name} — Attendee"
    %meta{ name: "viewport", content: "width=device-width,initial-scale=1" }/
    = csrf_meta_tags
    = csp_meta_tag
    = yield :head
    %link{ href: "https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap", rel: "stylesheet" }/
    = stylesheet_link_tag :app, "data-turbo-track": "reload"
    = javascript_importmap_tags
  %body.bg-base-200.min-h-screen.flex.flex-col
    - nav_link = ->(path, label){ link_to label, path, class: "px-3 py-2 rounded-lg text-sm font-medium hover:bg-base-200 #{'bg-primary text-primary-content hover:bg-primary' if current_page?(path)}" }
    %header.bg-base-100.border-b.border-base-300.sticky.top-0.z-30
      .container.mx-auto.px-5.py-3.flex.flex-col.gap-2{ class: "sm:flex-row sm:items-center sm:justify-between" }
        .flex.flex-col
          = link_to event_public_site_path(@event), class: "text-xl font-bold text-primary leading-tight" do
            = @event.name
          - if @event.tagline.present?
            %span.text-xs.opacity-60= @event.tagline
        %nav.flex.flex-wrap.items-center.gap-1
          = nav_link.(event_public_sessions_path(@event), "Sessions")
          = nav_link.(event_public_speakers_path(@event), "Speakers")
          = nav_link.(event_public_agenda_path(@event), "Agenda")
          = nav_link.(event_public_itinerary_path(@event), "Itinerary")
          = nav_link.(event_public_gallery_path(@event), "Gallery")
          .mx-1.h-5.w-px.bg-base-300{ class: "hidden sm:block" }
          - if user_signed_in?
            - if current_user.organizer_of?(@event)
              = link_to "Manage event", event_manage_root_path(@event), class: "px-3 py-2 rounded-lg text-sm font-medium hover:bg-base-200"
            = link_to "Dashboard", dashboard_path, class: "btn btn-primary btn-sm"
          - else
            = link_to "Home", root_path, class: "px-3 py-2 rounded-lg text-sm font-medium hover:bg-base-200"
            = link_to "Log in", new_user_session_path, class: "btn btn-primary btn-sm"
    %main.flex-1.container.mx-auto.px-5.py-8.w-full
      = yield
    %footer.bg-base-100.border-t.border-base-300.mt-8
      .container.mx-auto.px-5.py-6.flex.flex-col.gap-1.text-sm.opacity-70{ class: "sm:flex-row sm:items-center sm:justify-between" }
        %div
          %span.font-semibold= @event.name
          - if @event.date_range
            %span.mx-1 ·
            = @event.date_range
          - if @event.location.present?
            %span.mx-1 ·
            = @event.location
        %div
          Powered by
          = link_to "Open Session", root_path, class: "link link-hover font-medium"
