- sp = @speaker
.max-w-3xl.flex.flex-col.gap-5
  .flex.items-start.justify-between.gap-3
    .flex.items-center.gap-4
      = speaker_avatar(sp, size: 16)
      %div
        %h1.text-2xl.font-bold= sp.name
        %p.opacity-70= [sp.title, sp.company].compact.join(" · ")
        %p.text-sm.opacity-60= sp.email
        %span.badge.badge-sm.mt-1= sp.status.humanize
    = link_to "Edit", edit_event_manage_speaker_path(@event, sp), class: "btn btn-outline btn-sm"
  - if sp.bio.present?
    .card.bg-base-100.border.border-base-300
      .card-body
        %h2.font-semibold.text-sm.opacity-60 Bio
        %p.whitespace-pre-line= sp.bio
  .grid.grid-cols-1.gap-5{ class: "md:grid-cols-2" }
    .card.bg-base-100.border.border-base-300
      .card-body
        %h2.font-semibold.text-sm.opacity-60 Sessions
        - if @sessions.any?
          %ul.mt-1.flex.flex-col.gap-1
            - @sessions.each do |s|
              %li= link_to s.title, event_manage_submission_path(@event, s), class: "link text-sm"
        - else
          %p.opacity-60.text-sm None yet.
    .card.bg-base-100.border.border-base-300
      .card-body
        %h2.font-semibold.text-sm.opacity-60 Onboarding tasks
        - if @assignments.any?
          %ul.mt-1.flex.flex-col.gap-1
            - @assignments.each do |ta|
              %li.flex.items-center.justify-between.text-sm
                %span= ta.portal_task.title
                %span.badge.badge-xs{ class: ta.completed? ? "badge-success" : "badge-ghost" }= ta.status
        - else
          %p.opacity-60.text-sm No tasks assigned.
  - if sp.travel_notes.present?
    .card.bg-base-100.border.border-base-300
      .card-body
        %h2.font-semibold.text-sm.opacity-60 Travel / logistics
        %p.text-sm= sp.travel_notes
  - if sp.headshot.attached?
    .card.bg-base-100.border.border-base-300
      .card-body
        %h2.font-semibold.text-sm.opacity-60 Uploaded headshot
        = image_tag sp.headshot, class: "w-32 h-32 rounded object-cover mt-1"
        %p.text-xs.opacity-50.mt-1= "#{sp.headshot.filename} · #{sp.headshot.blob.created_at.strftime('%b %-d, %Y')}"
        = link_to "Download", rails_blob_path(sp.headshot, disposition: "attachment"), class: "btn btn-xs btn-outline mt-1"
