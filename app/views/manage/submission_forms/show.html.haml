- form = @form
.max-w-3xl.flex.flex-col.gap-5
  .flex.items-center.justify-between.flex-wrap.gap-2
    %div
      = link_to "← All forms", event_manage_submission_forms_path(@event), class: "text-sm link"
      %h1.text-2xl.font-bold= form.name.presence || "Submission Form"
    .flex.gap-2
      = link_to "Form settings", edit_event_manage_submission_form_path(@event, form), class: "btn btn-sm btn-outline"
      = link_to "View public form", event_submit_path(@event), class: "btn btn-sm btn-primary", target: "_blank"

  .card.bg-base-100.border.border-base-300{ data: { controller: "clipboard", "clipboard-text-value": event_submit_url(@event) } }
    .card-body.gap-2
      %h2.font-semibold.text-sm Public form link
      %p.text-xs.opacity-60 Share this link to collect submissions — no login required.
      .join.w-full
        %input.input.input-bordered.input-sm.join-item.w-full.font-mono.text-xs{ type: "text", readonly: true, value: event_submit_url(@event), data: { "clipboard-target": "source" }, onclick: "this.select()" }
        %button.btn.btn-sm.join-item.tooltip.tooltip-left{ type: "button", "aria-label": "Copy link", data: { action: "clipboard#copy", tip: "Copy link" } }
          %svg.w-4.h-4{ fill: "none", stroke: "currentColor", "stroke-width": "2", viewbox: "0 0 24 24", data: { "clipboard-target": "copyIcon" } }
            %rect{ x: "9", y: "9", width: "13", height: "13", rx: "2", ry: "2" }
            %path{ d: "M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" }
          %svg.w-4.h-4.hidden.text-success{ fill: "none", stroke: "currentColor", "stroke-width": "2.5", viewbox: "0 0 24 24", data: { "clipboard-target": "checkIcon" } }
            %path{ d: "M20 6L9 17l-5-5" }

  .card.bg-base-100.border.border-base-300
    .card-body
      %h2.font-semibold.text-sm.opacity-60 Locked questions (always on the form)
      %ul.text-sm.flex.flex-col.gap-1.mt-1
        %li.flex.items-center.gap-2
          Session title
          %span.badge.badge-ghost.badge-xs required
        %li.flex.items-center.gap-2
          Abstract / description
          %span.badge.badge-ghost.badge-xs required
        %li Session format
        %li Track
        %li Speaker name &amp; email

  .card.bg-base-100.border.border-base-300
    .card-body
      %h2.font-semibold.text-sm.opacity-60.mb-2 Custom questions
      - if form.form_fields.any?
        .flex.flex-col.gap-2
          - form.form_fields.each do |field|
            .border.border-base-300.rounded-box.p-3
              .flex.items-center.justify-between.flex-wrap.gap-2
                %div
                  %span.font-medium= field.label
                  - if field.required
                    %span.text-error *
                  %span.badge.badge-ghost.badge-xs.ml-1= field.field_type.humanize
                  - if field.conditional_value.present?
                    %span.badge.badge-info.badge-xs.ml-1= "shows when format = #{field.conditional_value}"
                = button_to "Remove", event_manage_submission_form_form_field_path(@event, form, field), method: :delete, class: "btn btn-xs btn-ghost text-error"
              - if field.help_text.present?
                %p.text-xs.opacity-60= field.help_text
              - if field.option_list.any?
                %p.text-xs.opacity-60= "Options: #{field.option_list.join(', ')}"
      - else
        %p.opacity-60.text-sm No custom questions yet.

  .card.bg-base-200.border.border-base-300
    .card-body
      %h2.font-semibold.text-sm.mb-1 Add a question
      = form_tag event_manage_submission_form_form_fields_path(@event, form), method: :post, class: "flex flex-col gap-3" do
        .grid.grid-cols-1.gap-3{ class: "md:grid-cols-2" }
          = text_field_tag "form_field[label]", nil, placeholder: "Question label (e.g. Key takeaway)", class: "input input-bordered", required: true
          = select_tag "form_field[field_type]", options_for_select(FormField::FIELD_TYPES.map { |t| [t.humanize, t] }), class: "select select-bordered"
        = text_field_tag "form_field[help_text]", nil, placeholder: "Help text (optional)", class: "input input-bordered"
        = text_area_tag "form_field[options_text]", nil, placeholder: "Dropdown/checkbox options — one per line", class: "textarea textarea-bordered", rows: 2
        .grid.grid-cols-1.gap-3{ class: "md:grid-cols-2" }
          %label.label.cursor-pointer.gap-2.justify-start
            = check_box_tag "form_field[required]", "1", false, class: "checkbox checkbox-sm"
            %span.label-text Required
          = text_field_tag "form_field[conditional_value]", nil, placeholder: "Show only when format = … (optional)", class: "input input-bordered"
        = submit_tag "Add question", class: "btn btn-primary w-fit"
