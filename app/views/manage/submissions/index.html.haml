.flex.flex-col.gap-4
  .flex.items-center.justify-between.flex-wrap.gap-2
    %h1.text-2xl.font-bold Sessions
    = link_to "＋ New session", new_event_manage_submission_path(@event), class: "btn btn-primary btn-sm"
  -# status filter tabs
  .tabs.tabs-boxed.bg-base-100.border.border-base-300.w-fit
    = link_to "All (#{@event.submissions.count})", event_manage_submissions_path(@event), class: "tab #{'tab-active' unless params[:status].present?}"
    - %w[submitted under_review accepted rejected waitlisted].each do |st|
      = link_to "#{st.humanize} (#{@counts[st].to_i})", event_manage_submissions_path(@event, status: st), class: "tab #{'tab-active' if params[:status] == st}"
  = form_tag event_manage_submissions_path(@event), method: :get, class: "flex gap-2" do
    = hidden_field_tag :status, params[:status]
    = text_field_tag :q, params[:q], placeholder: "Search title or abstract…", class: "input input-bordered input-sm w-64"
    = submit_tag "Search", class: "btn btn-sm btn-outline"

  = form_tag bulk_status_event_manage_submissions_path(@event), method: :patch, class: "card bg-base-100 border border-base-300" do
    .card-body.p-0
      .overflow-x-auto
        %table.table
          %thead
            %tr
              %th
              %th Title
              %th Speaker
              %th Track
              %th Format
              %th Status
              %th Content
          %tbody
            - @submissions.each do |s|
              %tr
                %td= check_box_tag "submission_ids[]", s.id, false, class: "checkbox checkbox-sm"
                %td
                  = link_to s.title, event_manage_submission_path(@event, s), class: "link font-medium"
                  - if s.participants.size > 1
                    %span.badge.badge-ghost.badge-xs.ml-1= "+#{s.participants.size - 1} co-speaker"
                %td.text-sm= s.speaker_names.presence || s.user.email
                %td= track_chip(s.track)
                %td.text-sm= s.talk_format
                %td= status_badge(s.status)
                %td= content_status_badge(s.content_status)
      .flex.items-center.gap-2.p-3.border-t.border-base-300.flex-wrap
        %span.text-sm.opacity-60 With selected:
        = select_tag :status, options_for_select(Submission.statuses.keys.map { |k| [k.humanize, k] }), class: "select select-bordered select-sm"
        = submit_tag "Apply to selected", class: "btn btn-sm btn-primary"
  - if @submissions.empty?
    %p.opacity-60.text-sm.mt-4 No sessions match.
