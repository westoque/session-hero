.w-full.max-w-4xl.mx-auto.flex.flex-col.gap-4
  .flex.items-center.justify-between
    %h1.text-2xl.font-bold= "Submissions · #{@event.name}"
    = link_to "← Back to console", event_manage_root_path(@event), class: "btn btn-ghost btn-sm"
  - if @submissions.any?
    .overflow-x-auto
      %table.table.bg-base-100.border.border-base-300.rounded-box
        %thead
          %tr
            %th Title
            %th Speaker
            %th Status
            %th.text-right Set status
        %tbody
          - @submissions.each do |s|
            %tr
              %td
                .font-medium= s.title
                .text-xs.opacity-60.line-clamp-1= s.abstract
              %td
                = s.user.email
                - if s.speaker_profile&.name.present?
                  .text-xs.opacity-60= s.speaker_profile.name
              %td
                %span.badge.badge-sm.badge-ghost= s.status.humanize
              %td
                = simple_form_for s, url: event_manage_submission_path(@event, s), html: { class: "flex gap-1 justify-end items-center" } do |f|
                  = f.input :status, collection: Submission.statuses.keys.map { |k| [k.humanize, k] }, label: false, wrapper: false, input_html: { class: "select select-sm" }
                  = f.button :submit, "Save", class: "btn btn-sm btn-primary"
  - else
    .card.bg-base-200.border.border-dashed.border-base-300
      .card-body.items-center.text-center
        %p.opacity-70 No submissions yet.
