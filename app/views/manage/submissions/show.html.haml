- s = @submission
.max-w-4xl.flex.flex-col.gap-5
  .flex.items-start.justify-between.gap-3.flex-wrap
    %div
      %h1.text-2xl.font-bold= s.title
      .flex.items-center.gap-2.mt-1.flex-wrap
        = status_badge(s.status)
        = content_status_badge(s.content_status)
        = track_chip(s.track)
        %span.text-sm.opacity-60= s.talk_format
    = link_to "Edit", edit_event_manage_submission_path(@event, s), class: "btn btn-outline btn-sm"

  -# Decision + convert controls
  .card.bg-base-100.border.border-base-300
    .card-body.flex-row.flex-wrap.items-center.gap-2
      %span.text-sm.font-semibold Decision:
      - %w[accepted waitlisted rejected].each do |st|
        = button_to st.humanize, decide_event_manage_submission_path(@event, s, status: st), method: :patch, class: "btn btn-sm #{s.status == st ? 'btn-primary' : 'btn-outline'}"
      %span.opacity-40 |
      = button_to "Send to agenda", convert_event_manage_submission_path(@event, s), method: :post, class: "btn btn-sm btn-secondary"
      %span.opacity-40 |
      %span.text-sm.opacity-60 Content:
      = simple_form_for s, url: event_manage_submission_path(@event, s), method: :patch, html: { class: "flex gap-1 items-center" } do |cf|
        = cf.input :content_status, collection: Submission::CONTENT_STATUSES.map { |x| [x.humanize, x] }, label: false, wrapper: false, input_html: { class: "select select-sm", onchange: "this.form.requestSubmit()" }
        %noscript= cf.button :submit, "Set", class: "btn btn-sm"

  .grid.grid-cols-1.gap-5{ class: "md:grid-cols-3" }
    .md:col-span-2.flex.flex-col.gap-4
      .card.bg-base-100.border.border-base-300
        .card-body
          %h2.font-semibold.text-sm.opacity-60 Abstract
          %p.whitespace-pre-line= s.abstract
          - if s.key_takeaway.present?
            %p.mt-3.text-sm
              %span.font-semibold Key takeaway:
              = s.key_takeaway
          - if s.audience_level.present?
            %p.text-sm
              %span.font-semibold Audience level:
              = s.audience_level
          - if s.answers.any?
            .divider.my-2
            - s.answers.each do |k, v|
              %p.text-sm
                %span.font-semibold= "#{k}: "
                = v

      -# Reviews
      .card.bg-base-100.border.border-base-300
        .card-body
          %h2.font-semibold.text-sm.opacity-60 Reviews
          - reviews = s.reviews.where(status: "completed")
          - if reviews.any?
            - reviews.each do |r|
              .border.border-base-300.rounded-box.p-3.mb-2
                .flex.items-center.gap-2.text-sm
                  %span.font-medium= r.ai_generated? ? "AI evaluation" : r.user.display_name
                  - if r.ai_generated?
                    %span.badge.badge-info.badge-xs AI
                  %span.badge.badge-ghost.badge-xs= "avg #{r.numeric_average || '—'}"
                - r.review_round.review_criteria.each do |c|
                  - val = r.scores.to_h[c.id.to_s]
                  - next if val.blank?
                  %div.text-sm
                    %span.opacity-60= "#{c.label}: "
                    %span.font-medium= val
                - if r.comment.present?
                  %p.text-sm.mt-1.italic= r.comment
                - if r.ai_rationale.present?
                  %p.text-sm.mt-1.opacity-70= r.ai_rationale
          - else
            %p.opacity-60.text-sm No reviews yet.
            = link_to "Set up evaluation →", event_manage_review_rounds_path(@event), class: "link link-primary text-sm"

    .flex.flex-col.gap-4
      .card.bg-base-100.border.border-base-300
        .card-body
          %h2.font-semibold.text-sm.opacity-60 Speakers
          - s.speakers.each do |sp|
            - part = s.session_participants.find { |p| p.event_speaker_id == sp.id }
            .flex.items-center.gap-2.mb-2
              = speaker_avatar(sp, size: 8)
              %div
                %div.font-medium.text-sm= sp.name
                %div.text-xs.opacity-60= [sp.title, sp.company].compact.join(" · ")
              - if part&.role.present?
                %span.badge.badge-ghost.badge-xs.ml-auto= part.role

      - if s.starts_at
        .card.bg-base-100.border.border-base-300
          .card-body
            %h2.font-semibold.text-sm.opacity-60 Schedule
            %p.text-sm= "#{fmt_date(s.starts_at)} · #{s.time_range}"
            %p.text-sm= s.room&.name
            = link_to "Open agenda →", event_manage_agenda_path(@event), class: "link link-primary text-sm"

      -# Change history
      - if @versions.any?
        .card.bg-base-100.border.border-base-300
          .card-body
            %h2.font-semibold.text-sm.opacity-60 Change history
            - @versions.each do |v|
              .flex.items-center.justify-between.text-xs.border-b.border-base-200.py-1
                %div
                  %div= v.display_editor
                  %div.opacity-50= fmt_datetime(v.created_at)
                = button_to "Restore", restore_event_manage_session_version_path(@event, v), method: :post, class: "btn btn-xs btn-ghost"
