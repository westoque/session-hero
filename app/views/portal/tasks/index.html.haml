- content_for(:title, "My Tasks")
.w-full.max-w-4xl.mx-auto.flex.flex-col.gap-6
  .flex.items-center.justify-between
    %h1.text-3xl.font-bold My Tasks
    - done = @assignments.count(&:completed?)
    %span.badge.badge-lg.badge-primary= "#{done} of #{@assignments.size} complete"

  - if @assignments.any?
    .flex.flex-col.gap-3
      - @assignments.each do |a|
        - task = a.portal_task
        .card.bg-base-100.shadow-sm.border{ class: (a.completed? ? "border-success/40" : "border-base-300") }
          .card-body.gap-2
            .flex.items-start.justify-between.gap-3
              .flex.flex-col.gap-1
                %h2.text-lg.font-semibold
                  = task.title
                  - if task.required
                    %span.text-error{ title: "Required" } *
                  - if task.file_request?
                    %span.badge.badge-info.badge-sm File request
                - if task.description.present?
                  %p.text-sm.opacity-70= task.description
                .flex.gap-3.items-center.text-xs.opacity-60
                  - if task.due_on
                    %span= "Due #{fmt_date(task.due_on)}"
                  %span= a.event_speaker.event.name
                  - if task.external_link.present?
                    = link_to "Open link ↗", task.external_link, target: "_blank", class: "link link-primary"
              .flex.flex-col.items-end.gap-2
                - if a.completed?
                  %span.badge.badge-success.gap-1 ✓ Complete
                - else
                  %span.badge.badge-warning Incomplete
            .card-actions.justify-end.items-center.gap-2
              - if task.file_request?
                - sess = my_sessions_scope.where(event_id: task.event_id).first
                - if sess
                  = link_to "Upload files", portal_session_path(sess, anchor: "files"), class: "btn btn-outline btn-sm"
              - if a.completed?
                = button_to "Reopen", reopen_portal_task_path(a), method: :post, class: "btn btn-ghost btn-sm"
              - else
                = button_to "Mark complete", complete_portal_task_path(a), method: :post, class: "btn btn-primary btn-sm"
  - else
    .card.bg-base-100.shadow-md.border.border-base-300
      .card-body.items-center.text-center
        %p.opacity-70 No tasks assigned to you yet.
