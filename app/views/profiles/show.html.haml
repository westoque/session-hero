.w-full.max-w-2xl.mx-auto.flex.flex-col.gap-4
  .flex.items-center.justify-between
    %h1.text-2xl.font-bold Speaker profile
    = link_to "Edit", edit_profile_path, class: "btn btn-primary btn-sm"
  .card.bg-base-100.shadow-md.border.border-base-300
    .card-body
      - if @profile.persisted?
        %h2.card-title= @profile.name
        - if @profile.headline.present?
          %p.opacity-80= @profile.headline
        - if @profile.job_title.present? || @profile.company.present?
          %p.text-sm.opacity-70= [@profile.job_title, @profile.company].compact_blank.join(" · ")
        - if @profile.bio.present?
          %p.mt-2= @profile.bio
      - else
        %p.opacity-70 You haven't set up your speaker profile yet.
        = link_to "Set up profile", edit_profile_path, class: "btn btn-primary btn-sm mt-2"
  %p.text-xs.opacity-60 This profile is global — reused across every event you speak at, not per-event.
