.card.bg-base-100.shadow-sm.border.border-base-300
  .card-body.gap-3
    .flex.flex-wrap.items-start.justify-between.gap-2
      %h3.card-title.text-lg.leading-snug= session.title
      .flex.flex-wrap.gap-1.shrink-0
        - if session.talk_format.present?
          %span.badge.badge-ghost.badge-sm= session.talk_format
        = track_chip(session.track)
    - if session.starts_at
      .flex.flex-wrap.items-center.gap-x-3.gap-y-1.text-sm.opacity-70
        %span ▤ #{fmt_date(session.starts_at)}
        %span ◷ #{session.time_range}
        - if session.room
          %span ⌂ #{session.room.name}
    = disclosure_text(session.abstract)
    - if session.speakers.any?
      .flex.flex-col.gap-1.pt-1.border-t.border-base-200
        - session.speakers.each do |sp|
          .flex.items-center.gap-2
            = speaker_avatar(sp, size: 8)
            .leading-tight
              = link_to sp.name, event_public_speaker_path(@event, sp), class: "font-medium text-sm link link-hover"
              - if speaker_role(sp).present?
                %div.text-xs.opacity-60= speaker_role(sp)
