-# Google Analytics (gtag.js). Renders only in production and only when the
-# GA_MEASUREMENT_ID env var is set, so dev/test never send hits.
- if Rails.env.production? && (ga_id = ENV["GA_MEASUREMENT_ID"].presence)
  / Google tag (gtag.js)
  %script{ async: true, src: "https://www.googletagmanager.com/gtag/js?id=#{ga_id}" }
  :javascript
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '#{ga_id}');
