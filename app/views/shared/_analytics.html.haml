-# Analytics tags. Rendered only in production, each gated on its own env var
-# so dev/test never send hits.
- if Rails.env.production?
  - if (ga_id = ENV["GA_MEASUREMENT_ID"].presence)
    / Google tag (gtag.js)
    %script{ async: true, src: "https://www.googletagmanager.com/gtag/js?id=#{ga_id}" }
    :javascript
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', '#{ga_id}');
  - if (clarity_id = ENV["CLARITY_PROJECT_ID"].presence)
    / Microsoft Clarity
    :javascript
      (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "#{clarity_id}");
