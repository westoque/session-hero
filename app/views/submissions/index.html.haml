.w-full.max-w-3xl.mx-auto.flex.flex-col.gap-4
  .flex.items-center.justify-between
    %h1.text-2xl.font-bold= "Your submissions · #{@event.name}"
    = link_to "Submit another", event_submit_path(@event), class: "btn btn-primary btn-sm"
  - if @submissions.any?
    .flex.flex-col.gap-3
      - @submissions.each do |s|
        .card.bg-base-100.shadow-sm.border.border-base-300
          .card-body.py-4
            .flex.items-center.justify-between
              .flex.flex-col
                %span.font-semibold= s.title
                %span.badge.badge-sm.badge-ghost.mt-1= s.status.humanize
              = link_to "Edit", edit_event_submission_path(@event, s), class: "btn btn-ghost btn-sm"
  - else
    .card.bg-base-200.border.border-dashed.border-base-300
      .card-body.items-center.text-center
        %p.opacity-70 No submissions yet.
        = link_to "Submit a talk", event_submit_path(@event), class: "btn btn-primary btn-sm mt-1"
