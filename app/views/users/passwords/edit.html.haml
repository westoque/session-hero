.w-full.flex.justify-center
  .card.w-full.max-w-md.bg-base-100.shadow-xl.border.border-base-300
    .card-body
      %h1.text-2xl.font-bold.text-center.mb-1 Change your password
      %p.text-center.text-sm.opacity-70.mb-4 Choose a new password for your account.
      = simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f|
        = f.error_notification
        = f.input :reset_password_token, as: :hidden
        = f.input :password, required: true, autofocus: true, label: "New password", hint: (@minimum_password_length ? "#{@minimum_password_length} characters minimum" : false), input_html: { autocomplete: "new-password" }
        = f.input :password_confirmation, required: true, label: "Confirm new password", input_html: { autocomplete: "new-password" }
        .mt-6
          = f.button :submit, "Change my password", class: "btn btn-primary w-full"
      = render "users/shared/links"
