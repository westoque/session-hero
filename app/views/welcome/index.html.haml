.w-full.flex.flex-col.gap-12
  .rounded-box.overflow-hidden.text-center{ class: "bg-gradient-to-b from-base-200 to-base-100" }
    .flex.flex-col.items-center.gap-8.pt-16.px-6
      .max-w-2xl.flex.flex-col.gap-4
        %h1.text-5xl.font-bold.leading-tight One platform for your speakers, sessions, and event content.
        %p.text-lg.opacity-80 SessionHero helps you collect talk proposals, review them, onboard speakers, and publish your agenda — all in one place.
        .flex.flex-wrap.gap-3.justify-center.items-center.mt-2
          = link_to "Get started", new_user_registration_path, class: "btn btn-primary btn-lg"
          .text-base.opacity-70
            or
            = button_to "see live demo", demo_path, class: "link link-primary font-medium", form_class: "inline"
      = image_tag "/session-hero.png", alt: "SessionHero organizer dashboard", loading: "lazy", class: "w-full max-w-5xl h-auto rounded-t-box", style: "-webkit-mask-image: linear-gradient(to bottom, #000 78%, transparent); mask-image: linear-gradient(to bottom, #000 78%, transparent);"

  %section.flex.flex-col.gap-6
    .text-center.flex.flex-col.gap-1
      %h2.text-3xl.font-bold Everything between "call for papers" and "doors open"
      %p.opacity-70 One connected workflow, from the first submission to the public schedule.
    .grid.grid-cols-1.gap-4{ class: "md:grid-cols-3" }
      - @features.each do |icon, title, body|
        .card.bg-base-100.border.border-base-300
          .card-body.gap-1
            %div.text-2xl= icon
            %h3.card-title.text-base= title
            %p.text-sm.opacity-70= body

  %section.hero.bg-primary.text-primary-content.rounded-box.py-12
    .hero-content.text-center
      .max-w-xl.flex.flex-col.gap-3
        %h2.text-2xl.font-bold Ready to open your call for papers?
        %p.opacity-90 Create an event, share your submission link, and start collecting proposals in minutes.
        %div
          = link_to "Create your event", new_user_registration_path, class: "btn btn-lg"
