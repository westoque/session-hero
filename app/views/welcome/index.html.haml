.w-full.flex.flex-col.gap-10
  .hero.bg-base-200.rounded-box.py-14
    .hero-content.text-center
      .max-w-xl
        %h1.text-4xl.font-bold Open Session
        %p.py-3.opacity-80 The open-source platform for running a conference call-for-papers, reviewing talks, onboarding speakers, and publishing your agenda.
        .flex.flex-wrap.gap-2.justify-center
          - if user_signed_in?
            = link_to "Your dashboard", dashboard_path, class: "btn btn-primary"
            = link_to "Speaker portal", portal_root_path, class: "btn btn-outline"
            = link_to "Speaker CRM", crm_root_path, class: "btn btn-outline"
          - else
            = link_to "Log in", new_user_session_path, class: "btn btn-primary"
            = link_to "Sign up", new_user_registration_path, class: "btn btn-outline"

  - if @featured
    %section.flex.flex-col.gap-3
      %h2.text-2xl.font-bold Browse events
      .grid.grid-cols-1.gap-4{ class: "md:grid-cols-2 lg:grid-cols-3" }
        - @events.each do |event|
          .card.bg-base-100.shadow-md.border.border-base-300
            .card-body
              %h3.card-title= event.name
              %p.text-sm.opacity-70= [event.date_range, event.location].compact.join(" · ")
              - if event.tagline.present?
                %p.text-sm.opacity-60= event.tagline
              .card-actions.mt-2.flex-wrap
                = link_to "Event site", event_public_site_path(event), class: "btn btn-primary btn-sm"
                = link_to "Sessions", event_public_sessions_path(event), class: "btn btn-ghost btn-sm"
                = link_to "Speakers", event_public_speakers_path(event), class: "btn btn-ghost btn-sm"
                = link_to "Agenda", event_public_agenda_path(event), class: "btn btn-ghost btn-sm"
                = link_to "Submit a talk", event_submit_path(event), class: "btn btn-secondary btn-sm"

  %section.grid.grid-cols-1.gap-4{ class: "md:grid-cols-3" }
    - [["Call for Papers", "Custom forms with conditional logic, drafts, and deadline enforcement."], ["Review & Decide", "Multi-round scorecards, blind review, weighted scores, and exports."], ["Publish", "Speaker portals, a drag-free agenda builder, and public widgets."]].each do |title, body|
      .card.bg-base-100.border.border-base-300
        .card-body
          %h3.card-title.text-base= title
          %p.text-sm.opacity-70= body
